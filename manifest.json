{
  "manifest_version": 2,
  "name": "Download Path Switcher",
  "version": "0.2.2",
  "description": "Windows-only Firefox extension that saves multiple download destinations and routes completed downloads to the selected folder using a local native helper.",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_action": {
    "default_title": "Download Path Switcher",
    "default_popup": "popup/popup.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "64": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "download-path-switcher@filelocation.local",
      "data_collection_permissions": {
        "required": [
          "websiteActivity"
        ]
      },
      "strict_min_version": "140.0"
    }
  }
}
