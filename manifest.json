{
  "manifest_version": 2,
  "name": "Download Path Switcher",
  "version": "0.1.0",
  "description": "Save multiple download destinations and route finished Firefox downloads to the currently selected folder.",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_action": {
    "default_title": "Download Path Switcher",
    "default_popup": "popup/popup.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "64": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "download-path-switcher@filelocation.local",
      "strict_min_version": "109.0"
    }
  }
}
